# ─── Tutorium `.env.example` ───────────────────────────────────────
# Copy to `.env.local` and fill in. NEVER commit `.env.local`.
# `npm run env:sync` seeds this from MetaForge\.env (Featherless + Speechmatics).

# ── Speech-to-text (required for voice features) ──────────────────
SPEECHMATICS_API_KEY=

# ── LLM — OpenAI-compatible, fully switchable via env ─────────────
# Default provider is Featherless. To use ANY OpenAI-compatible host
# (Token Factory, OpenRouter, Groq, Together, local vLLM/Ollama, ...),
# set these three vars — no code changes needed:

# Base URL of the /chat/completions endpoint (e.g. provider root, incl. `/v1` or not)
TUTORIUM_LLM_BASE_URL=https://api.featherless.ai/v1

# API key for that provider (falls back to FEATHERLESS_API_KEY if unset)
TUTORIUM_LLM_API_KEY=

# Model id the provider serves (featherless uses HF-style ids like zai-org/GLM-5.3-Flash;
# Token Factory / OpenAI-style endpoints use names like gpt-4o-mini or vendor/model)
TUTORIUM_LLM_MODEL=zai-org/GLM-5.3-Flash

# Fallback model tried after the primary fails/retries (optional)
TUTORIUM_LLM_FALLBACK_MODEL=Qwen/Qwen2.5-7B-Instruct

# Per-request timeout ms (optional, default 45000)
# TUTORIUM_LLM_TIMEOUT_MS=45000

# ── OCR (scanned PDF/image fallback) ─────────────────────────────────
# Optional. Without these, scanned PDFs get a friendly 422 saying OCR isn't
# configured. With them, /api/ingest falls through to a Vision-Language Model
# (Qwen-VL via Featherless) when the PDF has no extractable text.
#
# Defaults: TUTORIUM_OCR_API_KEY falls back to TUTORIUM_LLM_API_KEY, so you
# usually only need to set TUTORIUM_OCR_MODEL. Set a separate key only if you
# want OCR billed to a different account.
#
# TUTORIUM_OCR_BASE_URL=https://api.featherless.ai/v1
# TUTORIUM_OCR_API_KEY=
TUTORIUM_OCR_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
# Per-request timeout ms (optional, default 90000)
# TUTORIUM_OCR_TIMEOUT_MS=90000

# ── Provider-preset examples (comment/uncomment to switch) ─────────
# Token Factory (anonymized/open-models router):
#   TUTORIUM_LLM_BASE_URL=https://api.tokfactory.ai/v1
#   TUTORIUM_LLM_API_KEY=tk_...
#   TUTORIUM_LLM_MODEL=<your-model-id>

# OpenRouter:
#   TUTORIUM_LLM_BASE_URL=https://openrouter.ai/api/v1
#   TUTORIUM_LLM_API_KEY=sk-or-v1-...
#   TUTORIUM_LLM_MODEL=anthropic/claude-3.5-sonnet

# Local Ollama (OpenAI-compatible):
#   TUTORIUM_LLM_BASE_URL=http://localhost:11434/v1
#   TUTORIUM_LLM_API_KEY=ollama
#   TUTORIUM_LLM_MODEL=llama3.1
# ── Auth (Clerk) — required for deployment ────────────────────────
# Create a free app at https://dashboard.clerk.com and paste both keys.
# Without these, the app runs in local demo fallback (single demo user).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
